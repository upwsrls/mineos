#cloud-config
# ===========================================================================
# mineOS - Ubuntu Server 24.04 autoinstall (subiquity / cloud-init)
# ---------------------------------------------------------------------------
# Questo file pilota l'installazione NON presidiata di Ubuntu Server e, a fine
# installazione, installa il payload mineOS nel sistema target e abilita i
# servizi systemd. Viene letto dall'installer perche' passiamo da GRUB:
#     autoinstall ds=nocloud;s=/cdrom/server/
#
# Credenziali di DEFAULT: utente 'miner' / password 'miner'.
# >>> CAMBIALA dopo il primo accesso: `passwd` (o rigenera l'hash con
#     `openssl passwd -6 'NUOVA_PASSWORD'` e sostituisci il campo 'password'). <<<
# ===========================================================================
autoinstall:
  version: 1

  # Lingua/tastiera: adatta se necessario.
  locale: en_US.UTF-8
  keyboard:
    layout: it

  # --- Rete: DHCP su tutte le interfacce ethernet --------------------------
  network:
    version: 2
    ethernets:
      all-en:
        match:
          name: "en*"
        dhcp4: true
        # 'optional' evita che il boot resti appeso se un'interfaccia e' giu'.
        optional: true

  # --- Identita' del sistema ----------------------------------------------
  identity:
    hostname: mineos-rig
    username: miner
    # Hash SHA-512 della password 'miner' (cambiala dopo il primo accesso).
    password: "$6$qbgbcPDjqRvs82gF$J95ZfKm.cVMphVO0qEKCKFV6yGMilTguQtYYycwRyKZEi2KXZ91EOM4QPYBk6QuonI4QBqr4APAM5RfSwgTwt0"

  # SSH abilitato per la gestione remota del rig.
  ssh:
    install-server: true
    allow-pw: true

  # --- Pulizia disco PRIMA del partizionamento -----------------------------
  # Cause tipiche di crash autoinstall + "disk full" su rig gia' usati:
  #   - firme/superblock residui (LVM, mdraid, vecchie partizioni) che fanno
  #     fallire curtin durante il partizionamento;
  #   - selezione del disco sbagliato (USB o disco piccolo) come target.
  # Qui azzeriamo firme e tabella partizioni SUL DISCO INTERNO PIU' GRANDE,
  # ESCLUDENDO esplicitamente il supporto USB di avvio (quello che monta /cdrom).
  early-commands:
    - |
      set -x
      # Disco di boot (USB live): quello che contiene /cdrom.
      boot_src="$(findmnt -no SOURCE /cdrom 2>/dev/null || true)"
      boot_disk="$(lsblk -no PKNAME "$boot_src" 2>/dev/null | head -1 || true)"
      # Disco target = il piu' grande che NON sia l'USB di boot.
      target="$(lsblk -bdno NAME,SIZE,TYPE \
                | awk '$3=="disk"{print $1" "$2}' \
                | { [ -n "$boot_disk" ] && grep -v "^${boot_disk} " || cat; } \
                | sort -k2 -n | tail -1 | awk '{print $1}')"
      if [ -n "$target" ] && [ "$target" != "$boot_disk" ]; then
        echo "[mineos-early] Azzero firme/partizioni su /dev/$target (boot USB: ${boot_disk:-?})"
        swapoff -a || true
        # Disattiva eventuali LVM/mdraid che tengono occupato il disco.
        vgchange -an 2>/dev/null || true
        mdadm --stop --scan 2>/dev/null || true
        wipefs -a "/dev/$target" 2>/dev/null || true
        sgdisk --zap-all "/dev/$target" 2>/dev/null || true
        # Azzera l'inizio del disco (GPT primaria + eventuali header residui).
        dd if=/dev/zero of="/dev/$target" bs=1M count=32 oflag=direct 2>/dev/null || true
        partprobe "/dev/$target" 2>/dev/null || true
      else
        echo "[mineos-early] Nessun disco target sicuro trovato: salto wipe."
      fi

  # --- Storage: partizionamento ESPLICITO su tutto il disco interno --------
  # Config esplicita (non 'layout: direct') per evitare i due problemi classici:
  #   1) root sottodimensionato -> "disk full" subito dopo l'installazione;
  #   2) riuso di partizioni esistenti -> crash su superblock residui.
  # match {size: largest} sceglie il disco piu' grande (l'SSD interno, non l'USB).
  # wipe: superblock-recursive pulisce ogni firma prima di partizionare.
  # Schema ibrido BIOS+UEFI: bios_grub (1M) + ESP (=512M) + root ext4 (resto).
  storage:
    swap:
      size: 0
    config:
      - {type: disk, id: disk0, match: {size: largest}, ptable: gpt, wipe: superblock-recursive, preserve: false}
      - {type: partition, id: bios_boot, device: disk0, size: 1M, flag: bios_grub, wipe: superblock}
      - {type: partition, id: efi, device: disk0, size: 512M, flag: boot, grub_device: true, wipe: superblock}
      - {type: format, id: efi_fmt, volume: efi, fstype: fat32}
      - {type: mount, id: efi_mount, device: efi_fmt, path: /boot/efi}
      - {type: partition, id: root, device: disk0, size: -1, wipe: superblock}
      - {type: format, id: root_fmt, volume: root, fstype: ext4}
      - {type: mount, id: root_mount, device: root_fmt, path: /}

  # --- Pacchetti minimi necessari gia' in fase di installazione ------------
  packages:
    - curl
    - tar
    - gzip
    - ca-certificates
    - pciutils
    - jq
    # SSH garantito nell'immagine (gestione remota headless).
    - openssh-server

  # Aggiornamenti durante l'installer: solo pocket -security (il resto lo
  # gestisce update-mineos.sh sul sistema installato).
  # NB: 'package_update'/'package_upgrade' sono direttive cloud-init, NON chiavi
  # autoinstall: messe qui sotto vengono rifiutate dallo schema subiquity.
  updates: security

  # --- Comandi post-installazione (target montato in /target) --------------
  # /cdrom = ISO montata. Estraiamo il payload mineOS nel sistema installato
  # e lanciamo l'installer in-target che abilita i servizi systemd.
  late-commands:
    - mkdir -p /target/opt/mineos
    - tar -xzf /cdrom/mineos/mineos-payload.tar.gz -C /target/
    - cp /cdrom/mineos/install.sh /target/root/mineos-install.sh
    - curtin in-target --target=/target -- bash /root/mineos-install.sh
    - rm -f /target/root/mineos-install.sh

  # Reboot automatico a fine installazione.
  shutdown: reboot
